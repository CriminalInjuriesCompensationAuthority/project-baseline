#!/usr/bin/env node
// Starter server bootstrap — CREATE-ONLY scaffold from project-baseline (node-service profile).
// This file is yours once generated; the baseline never overwrites it.

import http from 'node:http';
import app from '../app.js';

const port = Number.parseInt(process.env.APP_PORT ?? '5000', 10);
app.set('port', port);

const server = http.createServer(app);

server.on('error', (error) => {
    if (error.syscall !== 'listen') {
        throw error;
    }
    switch (error.code) {
        case 'EACCES':
            console.error(`Port ${port} requires elevated privileges`);
            process.exit(1);
            break;
        case 'EADDRINUSE':
            console.error(`Port ${port} is already in use`);
            process.exit(1);
            break;
        default:
            throw error;
    }
});

server.on('listening', () => {
    console.warn(`Listening on port ${port}`);
});

server.listen(port);
